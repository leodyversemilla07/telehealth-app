FROM node:22-alpine AS base

# Install openssl and libc6-compat for build tools
RUN apk add --no-cache openssl libc6-compat

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /app

# Copy root manifest and workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json biome.json ./

# Copy packages and apps
COPY packages ./packages
COPY apps ./apps

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client and build monorepo packages + web in dependency order
RUN pnpm --filter @telehealth/db generate && \
    pnpm --filter @telehealth/env build && \
    pnpm --filter @workspace/shared build && \
    pnpm --filter @telehealth/db build && \
    pnpm --filter @telehealth/auth build && \
    pnpm --filter api build && \
    pnpm --filter web build

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["pnpm", "--filter", "web", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
