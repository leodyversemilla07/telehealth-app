FROM node:24-alpine AS base

# Install openssl and libc6-compat for Prisma & build tools
RUN apk add --no-cache openssl libc6-compat

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /app

# Copy root manifest and workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json biome.json ./

# Copy packages and apps
COPY packages ./packages
COPY apps ./apps

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client and build all packages + api in dependency order
RUN pnpm --filter @telehealth/db generate && \
    pnpm --filter @telehealth/env build && \
    pnpm --filter @workspace/shared build && \
    pnpm --filter @telehealth/db build && \
    pnpm --filter @telehealth/auth build && \
    pnpm --filter api build

EXPOSE 3001

ENV PORT=3001
ENV NODE_ENV=production

# Apply migrations and launch the API. Demo seeding is deliberately excluded:
# the seed script refuses to run in production and production data must never
# receive the well-known development accounts.
CMD ["sh", "-c", "pnpm --filter @telehealth/db exec prisma migrate deploy && pnpm --filter api start"]
