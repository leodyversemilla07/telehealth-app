{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    "./app-router": "./src/trpc/generated/server.ts"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome lint",
    "format": "biome check --write",
    "format:check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "trpc:generate": "nestjs-trpc generate -e src/app.module.ts -r \"**/*.router.ts\" -o src/trpc/generated",
    "trpc:watch": "nestjs-trpc watch -e src/app.module.ts -r \"**/*.router.ts\" -o src/trpc/generated",
    "postinstall": "node scripts/chmod-trpc-binary.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@telehealth/auth": "workspace:*",
    "@telehealth/db": "workspace:*",
    "@telehealth/env": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@trpc/server": "^11.18.0",
    "@workspace/shared": "workspace:*",
    "better-auth": "^1.6.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^3.21.0",
    "livekit-server-sdk": "^2.17.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-trpc": "^2.13.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "tsconfig-paths": "^4.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@workspace/typescript-config": "workspace:*",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3",
    "cross-env": "^10.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^isomorphic-dompurify$": "<rootDir>/../test/mocks/isomorphic-dompurify.ts",
      "^@telehealth/db$": "<rootDir>/../test/mocks/telehealth-db.ts",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/../test/mocks/nestjs-better-auth.ts",
      "^@/prisma/prisma\\.service$": "<rootDir>/../test/mocks/prisma.service.ts",
      "^@/notifications/notifications\\.service$": "<rootDir>/../test/mocks/notifications.service.ts",
      "^@workspace/shared$": "<rootDir>/../test/mocks/workspace-shared.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^better-auth/node$": "<rootDir>/../test/mocks/better-auth-node.ts",
      "^@aws-sdk/client-s3$": "<rootDir>/../test/mocks/aws-sdk-client-s3.ts"
    },
    "resolver": "<rootDir>/../test/resolver.cjs",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 55,
        "lines": 62,
        "statements": 60
      }
    },
    "testEnvironment": "node"
  }
}
