{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    "./app-router": "./src/trpc/generated/server.ts"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome lint",
    "format": "biome check --write",
    "format:check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "trpc:generate": "nestjs-trpc generate -e src/app.module.ts -r \"**/*.router.ts\" -o src/trpc/generated && node scripts/patch-trpc-transformer.mjs",
    "trpc:watch": "nestjs-trpc watch -e src/app.module.ts -r \"**/*.router.ts\" -o src/trpc/generated",
    "postinstall": "node scripts/chmod-trpc-binary.mjs",
    "test:e2e:db": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e-db.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@telehealth/auth": "workspace:*",
    "@telehealth/db": "workspace:*",
    "@telehealth/env": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@trpc/server": "^11.19.0",
    "@workspace/shared": "workspace:*",
    "better-auth": "^1.7.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^4.6.0",
    "livekit-server-sdk": "^2.19.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-trpc": "^2.13.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "tsconfig-paths": "^4.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@workspace/typescript-config": "workspace:*",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^isomorphic-dompurify$": "<rootDir>/../test/mocks/isomorphic-dompurify.ts",
      "^@telehealth/db$": "<rootDir>/../test/mocks/telehealth-db.ts",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/../test/mocks/nestjs-better-auth.ts",
      "^@/prisma/prisma\\.service$": "<rootDir>/../test/mocks/prisma.service.ts",
      "^@/notifications/notifications\\.service$": "<rootDir>/../test/mocks/notifications.service.ts",
      "^@workspace/shared$": "<rootDir>/../test/mocks/workspace-shared.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^better-auth/node$": "<rootDir>/../test/mocks/better-auth-node.ts",
      "^@aws-sdk/client-s3$": "<rootDir>/../test/mocks/aws-sdk-client-s3.ts"
    },
    "resolver": "<rootDir>/../test/resolver.cjs",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 55,
        "lines": 62,
        "statements": 60
      }
    },
    "testEnvironment": "node"
  }
}
