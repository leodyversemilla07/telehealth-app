{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "jest"]
  },
  "include": ["./db.e2e-spec.ts", "./mocks/**/*.ts", "../src/**/*.ts"],
  "exclude": [
    "node_modules",
    "../dist",
    "../src/trpc/generated",
    "../src/**/*.spec.ts",
    "../src/**/__service__/**"
  ]
}
