{
  "name": "@telehealth/auth",
  "version": "0.0.1",
  "private": true,
  "description": "Telehealth App authentication: Better Auth server config (factory), client config and password/security utilities.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "better-auth": "^1.6.23"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
