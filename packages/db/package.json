{
  "name": "@telehealth/db",
  "version": "0.0.1",
  "private": true,
  "description": "Single source of truth for the Telehealth App database: Prisma schema, migrations, seed and the shared PrismaClient.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@telehealth/env": "workspace:*",
    "better-auth": "^1.6.26"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "prisma": "^7.9.1",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3"
  }
}
