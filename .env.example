# =============================================================================
# Telehealth App — Workspace Environment (single root .env)
# =============================================================================
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored; `.env.local` (also gitignored) is merged on top and
# wins. Everything reads its env from here via `@telehealth/env/load` —
# packages/db (Prisma CLI + client), packages/auth, apps/api (main.ts, scripts)
# and apps/web (next.config.mjs loadRootEnv) — there are no per-app .env files.
# Generated secrets:  openssl rand -base64 32

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/telehealth?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Better Auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=""

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Cookie Domain (production only) ─────────────────────────────────────────
# Set to your domain for cross-subdomain cookies (e.g., .tele-health.app).
COOKIE_DOMAIN=""

# ── Social Login (OAuth, optional) ──────────────────────────────────────────
# Each provider only activates when BOTH credentials are present — a partial
# setup fails fast at API boot. Social login is currently skipped app-wide.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI=

# ── Email (Resend SDK) ──────────────────────────────────────────────────────
# Requires a verified sender domain in Resend. Sender must be from that domain.
RESEND_API_KEY=""
EMAIL_FROM="Telehealth App <noreply@tele-health.app>"

# ── File Storage ────────────────────────────────────────────────────────────
# Local storage is the default (files under apps/api/uploads). Set the S3 vars
# to use the private uploads bucket instead.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# ── LiveKit (Video Calls) ───────────────────────────────────────────────────
# From your LiveKit Cloud project settings (https://cloud.livekit.io).
# Keys beginning with "dev" are treated as unconfigured.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ── Session ─────────────────────────────────────────────────────────────────
# Session length in seconds. Default: 7 days (604800).
SESSION_EXPIRY_SECONDS=604800

# ── AI Recommendations (optional) ───────────────────────────────────────────
# NIM_API_KEY=

# ── Data Retention (optional, defaults below) ───────────────────────────────
# RETENTION_NOTIFICATIONS_DAYS=90
# RETENTION_SECURITY_ALERTS_DAYS=730
# RETENTION_AUDIT_LOGS_DAYS=2555

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate once: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=mailto:admin@tele-health.app

# ── Web (Next.js) ───────────────────────────────────────────────────────────
# Server-side API URL (Next.js rewrites proxy /api/* here).
API_URL=http://localhost:3001
# Client-side API URL (must include /api prefix). Empty = same-origin rewrites.
NEXT_PUBLIC_API_URL=""
# Must match VAPID_PUBLIC_KEY above.
NEXT_PUBLIC_VAPID_KEY=""
