{
  "name": "telehealth-app",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @telehealth/env build && pnpm --filter @telehealth/db generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm --filter api start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "biome check --write",
    "format:check": "biome check",
    "seed": "pnpm --filter @telehealth/db exec tsx prisma/seed.ts",
    "db:seed": "pnpm seed",
    "migrate": "pnpm --filter @telehealth/db exec prisma migrate deploy",
    "db:reset": "pnpm --filter @telehealth/db exec prisma migrate reset --force && pnpm seed",
    "db:studio": "pnpm --filter @telehealth/db exec prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@nestjs/cli": "^11.0.24",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^10.0.4",
    "prisma": "^7.9.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  }
}
